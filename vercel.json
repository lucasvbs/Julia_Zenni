{
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile --prod=false --registry=https://registry.npmjs.org/",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "name": "julia-zenni"
}
