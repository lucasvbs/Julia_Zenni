{
  "framework": "vite",
  "installCommand": "npm ci --include=dev --ignore-scripts --registry=https://registry.npmjs.org/",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "name": "julia-zenni"
}
